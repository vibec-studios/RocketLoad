{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Loads your resourcepacks like a rocketship.",
  "authors": [
    "Henny"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/rocketload/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.henny.rocketload.client.RocketloadClient"
    ]
  },
  "mixins": [
    "rocketload.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-language-kotlin": ">=1.13.0",
    "fabric-lifecycle-events-v1": "*",
    "minecraft": "${minecraft}"
  }
}
